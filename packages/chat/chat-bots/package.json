{
  "name": "@deepseek-ai/dsh-chat-bots",
  "description": "chat-agent bot registry: durable AI-companion records, per-bot agents with persona prompt sections, and the /chatapi/bots HTTP surface",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
